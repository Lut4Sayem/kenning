knowledgeforge-lrs.eastasia.cloudapp.azure.com {
	encode gzip
	# hashed file names: safe to cache for a year
	@immutable path /app/assets/* /app/excalidraw-assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	# live editing (WebSockets pass through)
	handle /collab* {
		reverse_proxy collab:1234
	}
	# the app and the collaboration service talk on the Docker network only
	handle /internal/* {
		respond 404
	}
	handle {
		reverse_proxy app:8080
	}
}
